DOMAIN_PROVIDER=mock
GODADDY_API_KEY=
GODADDY_API_SECRET=
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=

# ── Database ─────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ── Cache ────────────────────────────────────────────────
REDIS_URL=
REDIS_TOKEN=

# ── Auth (Supabase) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
